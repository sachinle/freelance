# Copy these names into Vercel › Project › Settings › Environment Variables.
# Never commit real values. For local testing with `vercel dev`, put them in
# .env.local (git-ignored).

# Gmail address that sends the enquiry emails
GMAIL_USER=your.address@gmail.com

# 16-character Google App Password (Google Account › Security › App passwords).
# NOT your normal Gmail password. Requires 2-Step Verification.
GMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx

# Optional: inbox that receives enquiries (defaults to GMAIL_USER)
MAIL_TO=freelance.work2k26@gmail.com
